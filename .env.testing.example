# Copy to .env.testing (git-ignored). Credentials for the LOCAL MySQL used by `php artisan test`.
# phpunit.xml fixes the host (127.0.0.1) and database (deskflow_api_testing); TestCase refuses to run against anything else.
# Create the empty database first:  CREATE DATABASE deskflow_api_testing;
APP_ENV=testing
DB_USERNAME=root
