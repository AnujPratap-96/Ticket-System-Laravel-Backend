# =====================================================================================
# DeskFlow API: PRODUCTION environment
#
#   * Copy this file to .env.production, generate the two secrets, then fill the empty lines.
#   * Everything below is ALREADY FILLED IN, except the lines marked  >>> FILL IN  (left empty).
#   * Render does NOT read this file. Open your Render service > Environment > "Add from .env",
#     paste the whole file, then fill the empty values there.
#   * Never commit this file or share it: it contains your APP_KEY and CRON_SECRET.
# =====================================================================================

# ---- App (filled) -------------------------------------------------------------------
APP_NAME=DeskFlow
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # generate: php artisan key:generate --show
APP_TIMEZONE=UTC
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Addresses  >>> FILL IN after you know the two URLs ---------------------------------
APP_URL=
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# ---- Database: Supabase Postgres  >>> FILL IN --------------------------------------------
DB_CONNECTION=pgsql
DB_URL=

# ---- Cache + queue use the DATABASE (no Redis needed) (filled) ---------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=array

# ---- Email (needed so people can verify their email)  >>> FILL IN ------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=DeskFlow

# ---- Attachments (Cloudinary)  >>> FILL IN ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI assistant (Groq)  >>> FILL IN the key (model and limits are filled) --------------
GROQ_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_DAILY_LIMIT=800

# ---- Login lifetime in minutes (filled) -----------------------------------------------------
SANCTUM_EXPIRATION=480

# ---- Scheduler/queue by URL (filled). An external pinger POSTs /api/v1/internal/tick with
#      header  X-Cron-Secret: <this value>  every minute. It runs SLA checks and sends queued emails,
#      so you do not need a paid worker. Delete the line to switch the endpoint off. -----------
CRON_SECRET=                    # generate: openssl rand -hex 32

# ---- Optional: customers replying by email. Leave empty to keep it switched off. -------------
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DEFAULT_DEPARTMENT=

# ---- Optional extras (leave as is to switch them off) ----------------------------------------------
# Live updates: needs the "deskflow-realtime" service from render.yaml. Use BROADCAST_CONNECTION=reverb and fill REVERB_*.
BROADCAST_CONNECTION=log
REVERB_APP_ID=deskflow
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
# Browser push. Create the keys once with: php artisan webpush:vapid   (never change them afterwards)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourcompany.com
