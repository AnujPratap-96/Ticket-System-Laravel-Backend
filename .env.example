APP_NAME=DeskFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deskflow_api
DB_USERNAME=root
# Reuse the database connection between requests (saves a connect + TLS handshake, ~0.2 s over the internet).
# Safe with a direct or session-mode connection; keep PHP workers below the database's connection limit.
DB_PERSISTENT=false
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime updates over WebSockets. Use "log" to switch them off (screens then refresh by polling).
BROADCAST_CONNECTION=log
REVERB_APP_ID=deskflow
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the API reaches the Reverb server, and where browsers connect to it
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# The Reverb process itself listens here (run: php artisan reverb:start)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

# --- DeskFlow ---------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_EXPIRATION=480

# Attachments (Cloudinary, signed direct uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inbound email webhook (leave empty to disable)
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DEFAULT_DEPARTMENT=

# --- AI assistant (Groq free tier; any OpenAI-compatible API works) ---
GROQ_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_DAILY_LIMIT=800
# AI_BASE_URL=https://api.groq.com/openai/v1

# --- Running without paid Render worker/cron (optional) ---
# Option 1: an external pinger POSTs /api/v1/internal/tick every minute with header X-Cron-Secret.
# CRON_SECRET=            # long random string (openssl rand -hex 32). Empty = endpoint disabled.
# Option 2: run the worker/scheduler inside the web container.
# RUN_WORKER_IN_WEB=true
# RUN_SCHEDULER_IN_WEB=true

# Browser push notifications (optional). Create keys with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourcompany.com
