# Used only by docker-compose (local). Production values live in Render's dashboard; see docs/RENDER_DEPLOY.md
APP_NAME=DeskFlow
APP_ENV=local
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=deskflow
DB_USERNAME=deskflow
DB_PASSWORD=secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log               # emails are written to the log; use smtp for real delivery
LOG_CHANNEL=stderr

# Optional features
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
