# Never bake secrets or local state into an image
.git
.gitignore
.gitattributes
.env
.env.*
!.env.example

# Built inside the image
vendor
node_modules
public/build
public/hot
public/storage

# Runtime state
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*
bootstrap/cache/*.php

# Dev only
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
.idea
.vscode
*.md
docs
Dockerfile
docker-compose.yml
